# Required application secret. Use a random value with at least 32 characters;
# replace this placeholder in every real environment and never commit the value.
DEPOSITA_SECRET_KEY=

# Optional: defaults to sqlite:///./deposita.db for local development.
DATABASE_URL=sqlite:///./deposita.db

# Comma-separated frontend origins. Leave empty to disable cross-origin access.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional public demo login. Keep disabled outside a dedicated demo environment.
DEMO_MODE=false
DEMO_USERNAME=demo
